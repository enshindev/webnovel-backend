ENV=dev
DATABASE_URL=postgresql+asyncpg://webnovel:webnovel@localhost:5432/webnovel
REDIS_URL=redis://localhost:6379/0

# OpenAI 兼容第三方服务
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=change-me
LLM_MODEL=your-model
LLM_PROVIDER=openai-compatible
# 可选：本地模型（Ollama / vLLM 的 OpenAI 兼容端点），作为 routing.yaml 的降级 provider
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
# fake 仅用于本地端到端测试
# 每日模型调用预算（元）；不设置则不限制
# DAILY_BUDGET=10
ASSISTANT_ENABLED=true
# 故事状态矛盾检查是否进入质检报告；G3 默认只读，precision 未达标不告警
STORY_STATE_CONTRADICTIONS_IN_QUALITY=false
# 可选：单用户 API Bearer Token；留空不启用
API_TOKEN=
# 可选：每客户端每分钟 API 请求数；0 不启用
RATE_LIMIT_PER_MINUTE=0
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
LOG_JSON=false
LOG_LEVEL=INFO
# 可选：outbox 成功事件推送到 webhook
OUTBOX_WEBHOOK_URL=

# 可选：embedding；留空则不启用向量检索
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024

# 可选：rerank
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# 可选：多模态实验（OpenAI 兼容 ASR / TTS / 图像接口）
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=alloy
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# 可选：OTLP exporter（docker compose --profile observability）
OTEL_EXPORTER_OTLP_ENDPOINT=

# 内容目录（相对路径按启动 cwd 解析；生产建议绝对路径）
PROMPTS_DIR=prompts
EVALS_DIR=evals
KNOWLEDGE_DIR=knowledge
PLATFORM_CONFIG_PATH=config/platform.yaml
ROUTING_CONFIG_PATH=config/routing.yaml
EXPORT_DIR=data/exports
LIBRARY_DIR=data/library
OCR_LANG=eng
PRICING_CONFIG_PATH=config/pricing.yaml
